{
  "name": "voadesk",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "VoaDesk: atendimento autorizado em localhost com vídeo H.264, diagnóstico e cliente portátil",
  "scripts": {
    "start": "node src/start.mjs --open",
    "start:pairing": "node src/pairing/service.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:security": "node --test tests/security.test.mjs",
    "test:load": "node tools/security-load.mjs",
    "test:production": "node tools/production-http-qa.mjs",
    "package:installation": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-installation.ps1",
    "test:video": "node tools/native-technician-smoke.mjs",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1",
    "test:support": "node tools/native-technician-smoke.mjs",
    "test:desktop": "node tools/native-technician-smoke.mjs",
    "test:client": "node tools/client-smoke.mjs",
    "test:native-session": "node tools/native-session-smoke.mjs",
    "test:update-ui": "node tools/update-ui-smoke.mjs",
    "test:design": "node tools/redesign-smoke.mjs",
    "test:local-screen": "node tools/local-test-smoke.mjs",
    "test:search": "node tools/search-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
